---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer';
import { Card, CardContent } from '../components/ui/card';
import { Badge } from '../components/ui/badge';
---

<Layout title="À Propos - CaféNomad Sénégal">
  <div class="min-h-screen flex flex-col">
    <Navbar client:load />
    
    <main class="flex-1">
      <!-- Hero -->
      <section class="bg-gradient-to-br from-primary via-ocean to-secondary py-16 md:py-24">
        <div class="container mx-auto px-4">
          <div class="max-w-3xl mx-auto text-center space-y-6">
            <h1 class="text-4xl md:text-5xl font-bold text-white">
              Notre Mission
            </h1>
            <p class="text-xl text-white/90 leading-relaxed">
              Démocratiser l'accès aux espaces de travail flexibles pour les étudiants, 
              freelances et nomades digitaux du Sénégal.
            </p>
          </div>
        </div>
      </section>

      <!-- Story -->
      <section class="py-20 bg-background">
        <div class="container mx-auto px-4">
          <div class="max-w-4xl mx-auto space-y-8">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold mb-4">L'Histoire de CaféNomad</h2>
            </div>

            <Card>
              <CardContent class="p-8 space-y-6 text-lg text-muted-foreground leading-relaxed">
                <p>
                  En 2026, alors que le remote work explose en Afrique, nous avons remarqué un problème : 
                  les coworking spaces à Dakar coûtent entre <strong>65 000 et 182 900 FCFA par mois</strong>, 
                  hors de portée pour la plupart des étudiants et jeunes freelances.
                </p>
                
                <p>
                  Avec un budget de <strong>100 000 FCFA</strong>, un étudiant ne peut se permettre qu'1-2 mois 
                  de coworking fixe. Mais les cafés ? Ils offrent WiFi, prises, ambiance et flexibilité pour 
                  seulement 2000-5000 FCFA par session.
                </p>

                <p>
                  <strong>CaféNomad</strong> est né de cette réalité : créer un guide communautaire des meilleurs 
                  cafés de Dakar et Thiès, avec notations crowdsourcées, système de labels (Bronze à Platinum), 
                  et partenariats pour des offres spéciales. Plus qu'une liste, c'est un écosystème pour connecter, 
                  travailler et grandir ensemble.
                </p>
              </CardContent>
            </Card>
          </div>
        </div>
      </section>

      <!-- Values -->
      <section class="py-20 bg-muted/30">
        <div class="container mx-auto px-4">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">Nos Valeurs</h2>
            <p class="text-muted-foreground max-w-2xl mx-auto">
              Ce qui guide chaque décision et partenariat que nous construisons.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
            <Card>
              <CardContent class="p-6 text-center space-y-4">
                <div class="w-14 h-14 mx-auto bg-primary/10 rounded-full flex items-center justify-center">
                  <svg class="h-7 w-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" stroke-width="2"/>
                    <circle cx="12" cy="12" r="4" stroke-width="2"/>
                  </svg>
                </div>
                <h3 class="text-xl font-semibold">Accessibilité</h3>
                <p class="text-muted-foreground">
                  Rendre les espaces de travail abordables pour tous, sans compromis sur la qualité.
                </p>
              </CardContent>
            </Card>

            <Card>
              <CardContent class="p-6 text-center space-y-4">
                <div class="w-14 h-14 mx-auto bg-ocean/10 rounded-full flex items-center justify-center">
                  <svg class="h-7 w-7 text-ocean" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                  </svg>
                </div>
                <h3 class="text-xl font-semibold">Communauté</h3>
                <p class="text-muted-foreground">
                  Favoriser les connexions authentiques entre nomades digitaux et créatifs.
                </p>
              </CardContent>
            </Card>

            <Card>
              <CardContent class="p-6 text-center space-y-4">
                <div class="w-14 h-14 mx-auto bg-secondary/10 rounded-full flex items-center justify-center">
                  <svg class="h-7 w-7 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                  </svg>
                </div>
                <h3 class="text-xl font-semibold">Innovation</h3>
                <p class="text-muted-foreground">
                  Évoluer constamment grâce aux retours communautaires et nouvelles technologies.
                </p>
              </CardContent>
            </Card>
          </div>
        </div>
      </section>

      <!-- Coverage -->
      <section class="py-20 bg-background">
        <div class="container mx-auto px-4">
          <div class="max-w-4xl mx-auto">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold mb-4">Notre Couverture</h2>
              <p class="text-muted-foreground">
                Actuellement présent dans deux villes clés du Sénégal, avec des plans d'expansion.
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <Card class="border-primary/20">
                <CardContent class="p-6 space-y-3">
                  <svg class="h-8 w-8 text-primary mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  <h3 class="text-2xl font-bold">Dakar</h3>
                  <p class="text-muted-foreground">
                    Capitale économique avec des quartiers comme Almadies, Mermoz, Point E, Plateau, 
                    Sacré-Cœur et Ngor. Hub de l'innovation tech au Sénégal.
                  </p>
                  <div class="pt-2">
                    <Badge class="bg-primary/10 text-primary border-0">8 cafés</Badge>
                  </div>
                </CardContent>
              </Card>

              <Card class="border-ocean/20">
                <CardContent class="p-6 space-y-3">
                  <svg class="h-8 w-8 text-ocean mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  <h3 class="text-2xl font-bold">Thiès</h3>
                  <p class="text-muted-foreground">
                    Deuxième ville du Sénégal avec ISEP, ENSA Thiès, et un écosystème tech émergent. 
                    Parfait pour étudiants et chercheurs.
                  </p>
                  <div class="pt-2">
                    <Badge class="bg-ocean/10 text-ocean border-0">Bientôt</Badge>
                  </div>
                </CardContent>
              </Card>
            </div>
          </div>
        </div>
      </section>

      <!-- Partners -->
      <section class="py-20 bg-muted/30">
        <div class="container mx-auto px-4">
          <div class="max-w-4xl mx-auto text-center space-y-8">
            <h2 class="text-3xl md:text-4xl font-bold">Communautés Partenaires</h2>
            <p class="text-muted-foreground text-lg">
              Nous collaborons avec les meilleures communautés tech du Sénégal pour organiser des événements 
              et créer des opportunités de networking.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              <Card>
                <CardContent class="p-6 text-center">
                  <h4 class="font-semibold text-lg mb-2">Galsen Dev</h4>
                  <p class="text-sm text-muted-foreground">
                    2500+ développeurs engagés dans le #SharingKnowledge
                  </p>
                </CardContent>
              </Card>

              <Card>
                <CardContent class="p-6 text-center">
                  <h4 class="font-semibold text-lg mb-2">Galsen AI</h4>
                  <p class="text-sm text-muted-foreground">
                    Intelligence artificielle et innovation au Sénégal
                  </p>
                </CardContent>
              </Card>

              <Card>
                <CardContent class="p-6 text-center">
                  <h4 class="font-semibold text-lg mb-2">Propel Community</h4>
                  <p class="text-sm text-muted-foreground">
                    Croissance et développement tech
                  </p>
                </CardContent>
              </Card>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="bg-gradient-to-br from-primary via-ocean to-secondary py-20 relative overflow-hidden">
        <div class="container mx-auto px-4 text-center relative z-10">
          <div class="max-w-2xl mx-auto space-y-6">
            <svg class="h-12 w-12 mx-auto text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
            <h2 class="text-3xl md:text-4xl font-bold text-white">
              Fait par des Nomades, pour des Nomades
            </h2>
            <p class="text-lg text-white/90">
              Rejoignez-nous pour bâtir ensemble l'écosystème de travail flexible du Sénégal.
            </p>
          </div>
        </div>
      </section>
    </main>

    <Footer client:load />
  </div>
</Layout>
