---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Footer from '../components/Footer';
import { CafeFilters } from '../components/CafeFilters';
import { cafes } from '../data/cafes';
---

<Layout title="Explorer les Cafés - CaféNomad Sénégal">
  <div class="min-h-screen flex flex-col">
    <Navbar client:load />

    <main class="flex-1">
      <!-- Header -->
      <section class="bg-gradient-to-br from-primary via-ocean to-secondary py-12">
        <div class="container mx-auto px-4">
          <div class="max-w-3xl mx-auto text-center space-y-4">
            <h1 class="text-3xl md:text-5xl font-bold text-white">
              Explorer les Cafés
            </h1>
            <p class="text-lg text-white/90">
              Trouvez votre prochain espace de travail idéal parmi {cafes.length} cafés sélectionnés.
            </p>
          </div>
        </div>
      </section>

      <!-- Search & Filters -->
      <section class="sticky top-16 z-40 bg-background/95 backdrop-blur border-b py-6">
        <div class="container mx-auto px-4">
          <CafeFilters cafes={cafes} client:load />
        </div>
      </section>
    </main>

    <Footer client:load />
  </div>
</Layout>
